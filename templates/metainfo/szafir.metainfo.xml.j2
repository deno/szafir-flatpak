<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>{{ app_id }}</id>
  <name>{{ name }}</name>
  <summary>{{ summary_en }}</summary>
  <summary xml:lang="pl">{{ summary_pl }}</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary=https://www.elektronicznypodpis.pl/</project_license>
  <developer id="pl.com.kir">
    <name>Krajowa Izba Rozliczeniowa S.A.</name>
  </developer>
  <description>
    <p>
      Szafir is the desktop application used for qualified electronic signatures, document
      verification, timestamping, encryption, and related certificate workflows from KIR.
    </p>
    <p>
      This Flatpak packages the upstream Szafir desktop application so it can be installed from the
      same repository as the browser integration proxy.
    </p>
    <p>
      Important setup notes:
    </p>
    <ul>
      <li>The Graphite PKCS#11 library is available at /app/extra/libCCGraphiteP11.2.0.5.6.so.</li>
      <li>By default the Flatpak has access to the Documents folder. Grant more filesystem access with Flatseal or Flatpak overrides if your workflow needs it.</li>
    </ul>
    <p xml:lang="pl">
      Szafir to aplikacja desktopowa używana do składania kwalifikowanych podpisów elektronicznych,
      weryfikacji dokumentów, znakowania czasem, szyfrowania oraz pracy z certyfikatami KIR.
    </p>
    <p>
      Ten Flatpak pakuje oficjalną aplikację Szafir, aby można ją było instalować z tego samego
      repozytorium co proxy integracji przeglądarkowej.
    </p>
    <p xml:lang="pl">
      Ważne uwagi konfiguracyjne:
    </p>
    <ul>
      <li xml:lang="pl">Biblioteka PKCS#11 Graphite jest dostępna pod ścieżką /app/extra/libCCGraphiteP11.2.0.5.6.so.</li>
      <li xml:lang="pl">Domyślnie Flatpak ma dostęp do folderu Dokumenty. Szerszy dostęp do plików można nadać przez Flatseal lub własne nadpisania Flatpak.</li>
    </ul>
    <p>
      This is a community-maintained Flatpak package and not an official KIR release channel.
    </p>
    <p xml:lang="pl">
      Jest to społecznościowy pakiet Flatpak, a nie oficjalny kanał dystrybucji KIR.
    </p>
  </description>
  <url type="homepage">https://www.elektronicznypodpis.pl/</url>
  <url type="bugtracker">https://github.com/deno/szafir-flatpak/issues</url>
  <launchable type="desktop-id">pl.kir.szafir.desktop</launchable>
  <releases>
    <release version="2.0.0.build703" date="2026-01-14">
      <description>
        <p>Community Flatpak metadata for the standalone Szafir desktop application.</p>
      </description>
    </release>
  </releases>
  <screenshots>
{% for shot in screenshots %}
    <screenshot{% if shot.default %} type="default"{% endif %}{% if shot.environment %} environment="{{ shot.environment }}"{% endif %}>
{% for img in shot.images %}
      <image{% if img.lang %} xml:lang="{{ img.lang }}"{% endif %}>{{ img.url }}</image>
{% endfor %}
    </screenshot>
{% endfor %}
  </screenshots>
  <content_rating type="oars-1.1" />
  <requires>
    <control>keyboard</control>
    <control>pointing</control>
    <display_length compare="ge">768</display_length>
  </requires>
</component>
