# KAboutData short description
#: szafir-host-proxy/src/main.cpp:191
msgid "Szafir native messaging proxy and host integrator."
msgstr "Proxy komunikacji natywnej i integrator hosta aplikacji Szafir."

#: szafir-host-proxy/src/main.cpp:218
msgid "Enable debug logging."
msgstr "Włącz rejestrowanie komunikatów debugowania."

# CLI option: --install
#: szafir-host-proxy/src/main.cpp:221
msgid "Install native host definitions and wrappers, then exit."
msgstr "Zainstaluj definicje oraz skrypty pośredniczące natywnego hosta i zakończ działanie."

# CLI option: --uninstall
#: szafir-host-proxy/src/main.cpp:224
msgid "Remove native host definitions/wrappers and permissions, then exit."
msgstr "Usuń definicje/skrypty pośredniczące natywnego hosta oraz uprawnienia i zakończ działanie."

# CLI option: --dry-run
#: szafir-host-proxy/src/main.cpp:227
msgid "Print planned file/permission operations without performing them. Requires --install or --uninstall."
msgstr "Wyświetl planowane operacje na plikach/uprawnieniach bez ich wykonywania. Wymaga podania opcji --install lub --uninstall."

#: szafir-host-proxy/src/main.cpp:230
msgid "Show modeless status window when launched."
msgstr "Pokaż niemodalne okno statusu podczas uruchamiania."

#: szafir-host-proxy/src/main.cpp:233
msgid "Show the first-run setup wizard even if all checks already pass."
msgstr "Pokaż kreator konfiguracji, nawet jeśli wszystkie kontrole zakończyły się pomyślnie."

#: szafir-host-proxy/src/main.cpp:237
msgid "Download enabled components headlessly, then exit (dev builds only)."
msgstr "Pobierz włączone komponenty bez interfejsu graficznego, a następnie zakończ działanie (tylko kompilacje deweloperskie)."

#: szafir-host-proxy/src/main.cpp:240
msgid "Run with a throwaway XDG environment (dev builds only)."
msgstr "Uruchom z tymczasowym środowiskiem XDG (tylko kompilacje deweloperskie)."

#: szafir-host-proxy/src/main.cpp:243
msgid "Force update checks to always report an update (dev builds only)."
msgstr "Wymuś zgłaszanie dostępności aktualizacji przy każdym sprawdzeniu (tylko kompilacje deweloperskie)."

#: szafir-host-proxy/src/main.cpp:246
msgid "Show an empty smart card reader list without querying pcscd (dev builds only)."
msgstr "Pokaż pustą listę czytników kart inteligentnych bez odpytywania pcscd (tylko kompilacje deweloperskie)."

#: szafir-host-proxy/src/main.cpp:249
msgid "Show several mock smart card readers without querying pcscd (dev builds only)."
msgstr "Pokaż kilka testowych czytników kart inteligentnych bez odpytywania pcscd (tylko kompilacje deweloperskie)."

# CLI option: --mock-browsers
msgid "Show several mock connected browsers without accepting native messaging connections (dev builds only)."
msgstr "Pokaż kilka testowych połączonych przeglądarek bez akceptowania połączeń natywnego przesyłania wiadomości (tylko kompilacje deweloperskie)."

# CLI error: conflicting options
#: szafir-host-proxy/src/main.cpp:279
msgid "Use either --install or --uninstall, not both."
msgstr "Użyj opcji --install albo --uninstall, nie obu jednocześnie."

# CLI error: dry-run without action
#: szafir-host-proxy/src/main.cpp:284
msgid "--dry-run requires --install or --uninstall."
msgstr "Opcja --dry-run wymaga podania opcji --install lub --uninstall."

# CLI error: install failed
#: szafir-host-proxy/src/main.cpp:292
msgid "Failed to install native host integration."
msgstr "Nie udało się zainstalować integracji natywnego hosta."

# CLI info: dry-run install done
#: szafir-host-proxy/src/main.cpp:295
msgid "Dry-run install complete."
msgstr "Próbna instalacja zakończona."

# CLI info: install succeeded
#: szafir-host-proxy/src/main.cpp:295
msgid "Native host integration installed."
msgstr "Pomyślnie zainstalowano integrację natywnego hosta."

# CLI error: uninstall failed
#: szafir-host-proxy/src/main.cpp:301
msgid "Failed to uninstall native host integration."
msgstr "Nie udało się odinstalować integracji natywnego hosta."

# CLI info: dry-run uninstall done
#: szafir-host-proxy/src/main.cpp:304
msgid "Dry-run uninstall complete."
msgstr "Próbne odinstalowanie zakończone."

# CLI info: uninstall succeeded
#: szafir-host-proxy/src/main.cpp:304
msgid "Native host integration removed."
msgstr "Pomyślnie usunięto integrację natywnego hosta."

# CLI error: D-Bus session bus unavailable
#: szafir-host-proxy/src/main.cpp:361
msgid "Cannot connect to the D-Bus session bus."
msgstr "Nie można połączyć się z magistralą sesji D-Bus."

# CLI info: already running
#: szafir-host-proxy/src/main.cpp:367
msgid "szafir-host-proxy is already running."
msgstr "Program szafir-host-proxy jest już uruchomiony."

# CLI error: D-Bus object registration failed
#: szafir-host-proxy/src/main.cpp:373
msgid "Failed to register D-Bus object."
msgstr "Nie udało się zarejestrować obiektu D-Bus."

# Warning: auto-install on startup failed
#: szafir-host-proxy/src/main.cpp:378
msgid "Failed to fully install native host integration; continuing startup."
msgstr "Nie udało się w pełni zainstalować integracji natywnego hosta; uruchamianie będzie kontynuowane."

