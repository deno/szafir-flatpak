#!/bin/sh

debug_log() {
    [ "${SZAFIR_HOST_DEBUG:-0}" = "1" ] && echo "DEBUG: $*" >&2
}

# Persistent tmp
mkdir -p "$HOME/.java/tmp"

debug_log "start-szafir-host-native.sh PID=$$ UID=$(id -u) HOME=$HOME XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}"

# Verified components store managed by szafir-host-proxy.
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
COMPONENTS_DIR="${XDG_DATA_HOME}/szafir-host-proxy/components"
INSTALLER_JAR="${COMPONENTS_DIR}/szafirhost-install.jar"

debug_log "COMPONENTS_DIR=$COMPONENTS_DIR INSTALLER_JAR=$INSTALLER_JAR"

if [ ! -f "${INSTALLER_JAR}" ]; then
    echo "ERROR: szafirhost-install.jar not found at ${INSTALLER_JAR}" >&2
    exit 1
fi

INSTALL_DIR="${XDG_DATA_HOME}/szafir-host-proxy/szafir_host"
LOCK_FILE="${INSTALL_DIR}/.install.lock"
JAR_PATH="${INSTALL_DIR}/SzafirHost.jar"
INSTALLED_FROM="${INSTALL_DIR}/.installed-from"

INSTALL_ONLY=0
if [ "$1" = "--install-only" ]; then
    INSTALL_ONLY=1
    shift
fi

# Prefer the bundled JRE; fall back to the system java (e.g. RPM builds).
if [ -x "@RUNTIME_PREFIX@/jre/bin/java" ]; then
    JAVA_BIN="@RUNTIME_PREFIX@/jre/bin/java"
else
    JAVA_BIN="java"
fi
debug_log "JAVA_BIN=$JAVA_BIN"

FORCE_INSTALL="${SZAFIR_FORCE_INSTALL:-0}"
INSTALLER_SHA="${SZAFIR_INSTALLER_SHA256:-}"

needs_install() {
    if [ ! -f "$JAR_PATH" ]; then
        return 0
    fi
    if [ "$FORCE_INSTALL" = "1" ]; then
        if [ -n "$INSTALLER_SHA" ] && [ -f "$INSTALLED_FROM" ]; then
            EXISTING_SHA="$(cat "$INSTALLED_FROM" 2>/dev/null)"
            if [ "$EXISTING_SHA" = "$INSTALLER_SHA" ]; then
                debug_log "already installed from this installer (sha=$INSTALLER_SHA), skipping"
                return 1
            fi
        fi
        return 0
    fi
    return 1
}

run_installer() {
    mkdir -p "$INSTALL_DIR"
    (
        flock -x 200
        if ! needs_install; then
            debug_log "install not needed after acquiring lock"
            exit 0
        fi

        if [ "$FORCE_INSTALL" = "1" ] && [ -f "$JAR_PATH" ]; then
            debug_log "backing up existing SzafirHost.jar"
            mv "$JAR_PATH" "${JAR_PATH}.bak"
        fi

        AUTO_XML="$(mktemp)"
        cat > "$AUTO_XML" << EOF
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<AutomatedInstallation langpack="pol">
    <com.izforge.izpack.panels.htmllicence.HTMLLicencePanel id="SHLicensePanel"/>
    <com.izforge.izpack.panels.target.TargetPanel id="SHTargetPanel">
        <installpath>${INSTALL_DIR}</installpath>
    </com.izforge.izpack.panels.target.TargetPanel>
    <com.izforge.izpack.panels.packs.PacksPanel id="SHPacksPanel">
        <pack index="0" name="Szafir Host" selected="true"/>
    </com.izforge.izpack.panels.packs.PacksPanel>
    <com.izforge.izpack.panels.install.InstallPanel id="SHInstallPanel"/>
    <com.izforge.izpack.panels.finish.FinishPanel id="SHFinishPanel"/>
</AutomatedInstallation>
EOF
        debug_log "running installer ${INSTALLER_JAR} (auto xml ${AUTO_XML})"
        "$JAVA_BIN" -jar "${INSTALLER_JAR}" "$AUTO_XML" >&2
        INSTALL_EXIT=$?
        debug_log "installer exit=$INSTALL_EXIT"
        rm -f "$AUTO_XML"

        if [ $INSTALL_EXIT -ne 0 ]; then
            if [ -f "${JAR_PATH}.bak" ]; then
                debug_log "installer failed, restoring backup"
                mv "${JAR_PATH}.bak" "$JAR_PATH"
            fi
            exit $INSTALL_EXIT
        fi

        rm -f "${JAR_PATH}.bak"

        if [ -n "$INSTALLER_SHA" ]; then
            echo "$INSTALLER_SHA" > "$INSTALLED_FROM"
        fi
    ) 200>"$LOCK_FILE"
}

if needs_install; then
    run_installer
fi

if [ "$INSTALL_ONLY" = "1" ]; then
    debug_log "install-only mode, exiting"
    exit 0
fi

cd "$INSTALL_DIR" || exit 1

debug_log "launching SzafirHost.jar (path=$JAR_PATH) args=$* cwd=$(pwd)"
exec "$JAVA_BIN" \
    -Djava.io.tmpdir="$HOME/.java/tmp" \
    -Dsun.java2d.uiScale.enabled=true \
    -jar SzafirHost.jar "$@"
