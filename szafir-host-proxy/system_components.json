{
  "system_components": [
    {
      "id": "pcsc-lite",
      "version": "2.5.1",
      "source_url": "https://pcsclite.apdu.fr/files/pcsc-lite-2.5.1.tar.xz",
      "source_sha256": "bfcfe38a20afc49849c6bf55325e38f449fc4b26d3923fdc32b969ae41a8741b",
      "display_name": {
        "en": "PC/SC Lite Smart Card Middleware",
        "pl": "Oprogramowanie pośredniczące kart PC/SC Lite"
      },
      "scope": "app",
      "cleanup": [
        "/bin/pcsc-spy",
        "/lib/libpcscspy*"
      ],
      "build": {
        "buildsystem": "meson",
        "config_opts": [
          "-Dlibudev=false",
          "-Dlibsystemd=false",
          "-Dusb=false",
          "-Dlibusb=false",
          "-Dpolkit=false",
          "-Dserial=false",
          "-Dipcdir=/run/pcscd"
        ]
      }
    }
  ]
}
